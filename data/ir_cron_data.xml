<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Dashboard Auto-Refresh -->
        <record id="ir_cron_dashboard_refresh" model="ir.cron">
            <field name="name">AI Analytics: Dashboard Auto-Refresh</field>
            <field name="model_id" ref="model_realtime_dashboard"/>
            <field name="state">code</field>
            <field name="code">model.refresh_dashboard_data()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
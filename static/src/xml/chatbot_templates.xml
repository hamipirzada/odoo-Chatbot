<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_analytics.ChatbotWidget" owl="1">
        <div class="ai-chatbot-container">
            <!-- Left Panel for Chat Management -->
            <div class="ai-chatbot-sidebar" t-att-class="state.sidebarCollapsed ? 'collapsed' : ''">
                <div class="ai-sidebar-header">
                    <h5 class="ai-sidebar-title">
                        <i class="fa fa-comments"/> Chats
                    </h5>
                    <button class="btn btn-sm btn-primary ai-new-chat-btn" t-on-click="startNewChat" title="New Chat">
                        <i class="fa fa-plus"/> New
                    </button>
                </div>
                
                <div class="ai-chat-list">
                    <t t-foreach="state.recentChats" t-as="chat" t-key="chat.id">
                        <div t-attf-class="ai-chat-item #{state.currentChatId === chat.id ? 'active' : ''}" 
                             t-on-click="() => this.loadChat(chat.id)">
                            <div class="ai-chat-preview">
                                <div class="ai-chat-title" t-esc="chat.name"/>
                                <div class="ai-chat-date" t-esc="this.formatChatDate(chat.date_iso || chat.date)"/>
                            </div>
                            <div class="ai-chat-actions">
                                <button class="btn btn-sm btn-outline-danger ai-delete-chat-btn" 
                                        t-on-click.stop="(event) => this.deleteChat(chat.id, event)" 
                                        title="Delete Chat">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                        </div>
                    </t>
                    
                    <div t-if="state.recentChats.length === 0" class="ai-no-chats">
                        <div class="text-muted text-center">
                            <i class="fa fa-comment-slash fa-2x mb-2"/>
                            <p>No recent chats</p>
                            <small>Start a new conversation</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Main Chat Area -->
            <div class="ai-chatbot-main">
                <div class="ai-chatbot-header">
                    <button class="btn btn-sm btn-secondary ai-sidebar-toggle" 
                            t-on-click="toggleSidebar" 
                            title="Toggle Sidebar">
                        <i t-attf-class="fa fa-#{state.sidebarCollapsed ? 'chevron-right' : 'chevron-left'}"/>
                    </button>
                    <div class="ai-chatbot-title">
                        <i class="fa fa-robot"/> AI Financial Analytics Assistant
                        <span class="ai-chatbot-status">
                            <i class="fa fa-circle text-success"/> Online
                        </span>
                    </div>
                    <div class="ai-model-selector">
                        <label for="llmModel" class="ai-model-label">Model:</label>
                        <select class="ai-model-select" t-ref="modelSelect" t-on-change="onModelChange">
                            <option value="claude">Claude (Anthropic)</option>
                        </select>
                    </div>
                    <div class="ai-chatbot-actions">
                        <button class="btn btn-sm btn-secondary" t-on-click="clearCurrentChat" title="Clear Current Chat">
                            <i class="fa fa-trash"/>
                        </button>
                    </div>
                </div>

            <div class="ai-chatbot-messages" t-ref="messagesContainer">
                <t t-foreach="state.messages" t-as="message" t-key="message_index">
                    <div t-attf-class="ai-message #{message.is_user ? 'user-message' : 'bot-message'} #{message.error ? 'error-message' : ''}">
                        <div class="ai-message-content">
                            <div class="ai-message-text" t-esc="message.message"/>
                            
                            <!-- Chart functionality removed - text-based responses only -->
                            
                            <div class="ai-message-meta">
                                <span t-if="message.enhanced" class="ai-enhanced-badge">
                                    <i class="fa fa-magic"/> Claude Enhanced
                                </span>
                                <!-- Chart badge removed - text-based responses only -->
                                <span class="ai-message-time" t-esc="message.timestamp"/>
                            </div>
                        </div>
                    </div>
                </t>

                <div t-if="state.isTyping" class="ai-message bot-message typing-message">
                    <div class="ai-message-content">
                        <div class="typing-indicator">
                            <div class="typing-dots">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="ai-chatbot-input">
                <div class="ai-input-container">
                    <textarea 
                        class="ai-message-input"
                        t-ref="messageInput"
                        placeholder="Ask me about your financial data, journal entries, invoices, or account balances..."
                        rows="1"
                        t-on-keypress="onKeyPress"
                    />
                    <button class="ai-send-btn" t-on-click="sendMessage" t-att-disabled="state.isTyping">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>
            </div> <!-- Close ai-chatbot-main -->
        </div>
    </t>
</templates>